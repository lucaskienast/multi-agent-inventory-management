      "updated": 1,
      "link": null,
      "locked": false,
      "text": "INVENTORY TOOLS  ->  starter helper\n- get_stock_level_tool(item, date)\n     -> get_stock_level\n- get_all_inventory_tool(date)\n     -> get_all_inventory\n- get_supplier_delivery_date_tool(date, qty)\n     -> get_supplier_delivery_date\n- get_cash_balance_tool(date)\n     -> get_cash_balance\n- restock_item(item, qty, date)\n     -> get_cash_balance (can we afford it?)\n     -> get_supplier_delivery_date (arrival)\n     -> create_transaction('stock_orders')",
      "originalText": "INVENTORY TOOLS  ->  starter helper\n- get_stock_level_tool(item, date)\n     -> get_stock_level\n- get_all_inventory_tool(date)\n     -> get_all_inventory\n- get_supplier_delivery_date_tool(date, qty)\n     -> get_supplier_delivery_date\n- get_cash_balance_tool(date)\n     -> get_cash_balance\n- restock_item(item, qty, date)\n     -> get_cash_balance (can we afford it?)\n     -> get_supplier_delivery_date (arrival)\n     -> create_transaction('stock_orders')",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "elhihhw64rx2dx",
      "lineHeight": 1.25,
