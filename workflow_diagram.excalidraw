      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SALES TOOLS  ->  starter helper\n- get_stock_level_tool(item, date)\n     -> get_stock_level\n- get_supplier_delivery_date_tool(date, qty)\n     -> get_supplier_delivery_date\n- generate_financial_report_tool(date)\n     -> generate_financial_report\n     (health check before large orders)\n- fulfill_order(item, qty, price, date)\n     -> get_stock_level (re-check)\n     -> create_transaction('sales')",
      "originalText": "SALES TOOLS  ->  starter helper\n- get_stock_level_tool(item, date)\n     -> get_stock_level\n- get_supplier_delivery_date_tool(date, qty)\n     -> get_supplier_delivery_date\n- generate_financial_report_tool(date)\n     -> generate_financial_report\n     (health check before large orders)\n- fulfill_order(item, qty, price, date)\n     -> get_stock_level (re-check)\n     -> create_transaction('sales')",
